# Resonance: copy to .env in the repo root
# Full reference: docs/CONFIGURATION.md (keep this file aligned when adding RESONANCE_* vars)
# Ops / failures: docs/RUNBOOK.md
# Local UI (Vite) defaults to http://127.0.0.1:8765 — keep CORS in sync if you change it.
# Start with: make serve (everyday, :8780) or make run (development, :8765 + :8000)

# Server
RESONANCE_HOST=127.0.0.1
RESONANCE_PORT=8000
RESONANCE_LOG_LEVEL=INFO
RESONANCE_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# RESONANCE_API_TOKEN=
# RESONANCE_TRUSTED_PROXIES=127.0.0.1
# RESONANCE_ENABLE_OPENAPI=true
# Single-process serve from backend/: RESONANCE_STATIC_DIR=../frontend/dist
# RESONANCE_STATIC_DIR=../frontend/dist
#
# UI token (Vite loads from frontend/.env — not this repo-root file):
#   echo 'VITE_API_TOKEN=same-as-RESONANCE_API_TOKEN' > frontend/.env

# Discovery
RESONANCE_DISCOVERY_METHOD=both
RESONANCE_DISCOVERY_TIMEOUT=5
RESONANCE_DISCOVERY_CACHE_TTL=300
RESONANCE_EMPTY_FLEET_REDISCOVERY_SECONDS=30
RESONANCE_DISCOVERED_GRACE_TTL=60
# RESONANCE_SSE_KEEPALIVE_SECONDS=15
# RESONANCE_SSE_QUEUE_SIZE=32
# RESONANCE_ALLOW_NON_PRIVATE_IPS=false
# mDNS always browses _musc + _musp (CI zones); there is no service-name setting.
# RESONANCE_BLUOS_PORT=11000
# RESONANCE_WEB_UI_PORT=80

# Polling / device HTTP
RESONANCE_POLL_INTERVAL=3
RESONANCE_STATUS_LONG_POLL_SECONDS=100
# RESONANCE_LONG_POLL_READ_SLACK_SECONDS=5
# RESONANCE_LONG_POLL_GAP_SECONDS=1
RESONANCE_DEVICE_HTTP_TIMEOUT=3
RESONANCE_MAX_CONCURRENT_DEVICE_CALLS=20
RESONANCE_CONTROL_RATE_LIMIT_SECONDS=0.1
# RESONANCE_CONTROL_INTERRUPT_WAIT_SECONDS=0.25
RESONANCE_API_RATE_LIMIT_SECONDS=0.05
# RESONANCE_FLEET_UPGRADES_CACHE_SECONDS=30
RESONANCE_CIRCUIT_FAILURE_THRESHOLD=5
RESONANCE_CIRCUIT_SLOW_POLL_SECONDS=15

# XML hardening
# RESONANCE_MAX_XML_SIZE=1048576
# RESONANCE_MAX_XML_DEPTH=20
# RESONANCE_MAX_XML_ELEMENTS=10000
